<h1><%= @place.name %></h1>

<a href="/places">Back to Places</a>

<h2>Entries</h2>

<a href="/places/<%= @place.id %>/entries/new">Log a New Entry</a>

<ul>
  <% @entries.each do |entry| %>
    <li>
      <strong><%= entry.title %></strong> - <%= entry.occurred_on %>
      <p><%= entry.description %></p>
    </li>
  <% end %>
</ul>